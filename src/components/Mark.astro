---
// Brand mark: a folded corner of kelsch cloth with a madder thread, the "C" of Clément woven in.
---
<svg viewBox="0 0 40 40" aria-hidden="true">
  <defs>
    <pattern id="kelsch-mark" width="10" height="10" patternUnits="userSpaceOnUse">
      <rect width="10" height="10" fill="#22408f" />
      <rect width="4" height="10" fill="#162c66" opacity=".8" />
      <rect width="10" height="4" fill="#162c66" opacity=".8" />
      <rect x="6.5" width="1" height="10" fill="#fff" opacity=".35" />
      <rect y="6.5" width="10" height="1" fill="#fff" opacity=".35" />
    </pattern>
  </defs>
  <rect x="1" y="1" width="38" height="38" rx="3" fill="url(#kelsch-mark)" />
  <rect x="1" y="1" width="38" height="38" rx="3" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="1.5" />
  <path d="M27.5 13.2A9.2 9.2 0 1 0 27.5 26.8" fill="none" stroke="#fff" stroke-width="4.2" stroke-linecap="round" />
  <path d="M6 33.5h28" stroke="#b0281f" stroke-width="2.4" stroke-linecap="round" />
</svg>
