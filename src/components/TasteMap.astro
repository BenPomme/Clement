---
// "Sa carte": Clément's favourite dishes placed on a world map (carte = menu and map).
// Rendered to static SVG at build time; no map library ships to the browser.
//
// Dish photos: drop a cut-out PNG (or JPG/WebP) named after the dish slug in
// src/assets/dishes/carte/ (e.g. pad-thai.png) and it appears on hover/tap.
// A real photo replaces the AI illustration of the same dish (pad-thai.ai.png) automatically.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { geoNaturalEarth1, geoPath, geoGraticule10, geoInterpolate } from 'd3-geo';
import { feature } from 'topojson-client';
import land110 from 'world-atlas/land-110m.json';

type Place = { n: number; place: string; dishes: string[]; at: [number, number]; lab: [number, number]; home?: boolean };

// Dishes as Clément listed them; `at` = origin of the dish, `lab` = where its tape sits.
const places: Place[] = [
  { n: 1, place: 'France', dishes: ['Poule au pot', 'Papillotes de saumon', 'Quiches', 'Poisson, petits pois', 'Mille-feuille mangue', 'Mont-blanc', 'Chocolat, griottes'], at: [7.34, 47.75], lab: [-44, 58], home: true },
  { n: 2, place: 'Italie', dishes: ['Lasagnes', 'Pâtes bolognaise', 'Pâtes carbonara', 'Pâtes Alfredo'], at: [12.5, 41.9], lab: [36, 60] },
  { n: 3, place: 'Maghreb', dishes: ['Chorba'], at: [3.06, 36.75], lab: [2, 25] },
  { n: 4, place: 'Inde', dishes: ['Aloo gobi'], at: [76.5, 29.5], lab: [62, 13] },
  { n: 5, place: 'Chine', dishes: ['Poitrine de porc braisée', 'Riz cantonais'], at: [116, 33], lab: [127, 48] },
  { n: 6, place: 'Thaïlande', dishes: ['Curry vert au poulet', 'Soupe de poulet à la thaïe', 'Pad thaï', 'Tom yum kung'], at: [100.5, 14.5], lab: [91, -4] },
  { n: 7, place: 'Vietnam', dishes: ['Porc au caramel'], at: [106.7, 11.2], lab: [131, 12] },
  { n: 8, place: 'Jamaïque', dishes: ['Poulet à la jamaïcaine'], at: [-77.3, 18.1], lab: [-74, 6] },
  { n: 9, place: 'Texas', dishes: ['Chili con carne'], at: [-98.5, 30.5], lab: [-100, 45] },
];

const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/dishes/carte/*.{png,jpg,jpeg,webp}', { eager: true });
// `<slug>.png` = Clément's own photo; `<slug>.ai.png` = AI-generated illustration (used only if no real photo).
const photo = (dish: string) => {
  const hits = Object.entries(files).filter(([p]) => p.split('/').pop()!.replace(/(\.ai)?\.\w+$/, '') === slug(dish));
  const real = hits.find(([p]) => !/\.ai\.\w+$/.test(p));
  const pick = real ?? hits[0];
  return pick ? { src: pick[1].default, ai: !real } : undefined;
};

const W = 1200;
const frame = { type: 'MultiPoint', coordinates: [[-112, -12], [150, -12], [-112, 64], [150, 64], [19, 72], [19, -14]] } as any;
const projection = geoNaturalEarth1().rotate([-19, 0]).fitWidth(W, frame);
const [[, y0], [, y1]] = geoPath(projection).bounds(frame);
const H = Math.round(y1 - y0);
projection.translate([projection.translate()[0], projection.translate()[1] - y0]).clipExtent([[0, 0], [W, H]]);
const path = geoPath(projection);

const landPath = path(feature(land110 as any, (land110 as any).objects.land) as any) ?? '';
const gridPath = path(geoGraticule10()) ?? '';
const home = places[0].at;
const threads = places.slice(1).map((p) => {
  const ip = geoInterpolate(home, p.at);
  return path({ type: 'LineString', coordinates: Array.from({ length: 33 }, (_, i) => ip(i / 32)) } as any) ?? '';
});
const pts = places.map((p) => {
  const [x, y] = projection(p.at)!;
  const [lx, ly] = projection(p.lab)!;
  return { ...p, x, y, lx, ly, items: p.dishes.map((d) => ({ name: d, img: photo(d) })) };
});
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<figure class="taste" aria-labelledby="taste-cap">
  <figcaption id="taste-cap" class="visually-hidden">Carte du monde : les plats préférés de Clément et leur pays d'origine</figcaption>
  <div class="map" style={`aspect-ratio:${W} / ${H}`}>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <path class="grid" d={gridPath} />
      <path class="land" d={landPath} />
      {threads.map((d) => <path class="thread" d={d} />)}
      {pts.map((p) => <line class="leader" x1={p.x} y1={p.y} x2={p.lx} y2={p.ly} />)}
    </svg>
    {pts.map((p) => (
      <span class:list={['pin', { home: p.home }]} style={`left:${pct(p.x, W)};top:${pct(p.y, H)}`} aria-hidden="true">{p.n}</span>
    ))}
  </div>
  <ol class="dishes">
    {pts.map((p, i) => (
      <li style={`--x:${pct(p.lx, W)};--y:${pct(p.ly, H)};--r:${i % 2 ? 1.2 : -1.6}deg`}>
        <span class="no" aria-hidden="true">{p.n}</span>
        <span class="tape">
          <b>{p.place}</b>
          <span class="list">
            {p.items.map((d) => d.img ? (
              <button type="button" class="dish has-img" aria-label={`${d.name} (voir la photo)`}>
                <span class="peek" aria-hidden="true">
                  <Picture src={d.img.src} alt="" widths={[240, 360, 480].filter((w) => w <= d.img!.src.width)} sizes="12rem" formats={['avif', 'webp']} fallbackFormat="webp" layout="none" loading="lazy" />
                  <span class:list={['ill', { real: !d.img.ai }]}>{d.img.ai ? "Photo d'illustration" : 'Photo de Clément'}</span>
                </span>
                {d.name}
              </button>
            ) : (
              <span class="dish">{d.name}</span>
            ))}
          </span>
        </span>
      </li>
    ))}
  </ol>
</figure>

<script>
  // Tap to show a dish photo (iOS Safari doesn't focus buttons on tap); tap elsewhere to close.
  const btns = document.querySelectorAll<HTMLButtonElement>('.taste .has-img');
  btns.forEach((b) => b.addEventListener('click', (e) => {
    e.stopPropagation();
    const was = b.classList.contains('open');
    btns.forEach((o) => o.classList.remove('open'));
    if (!was) { b.classList.add('open'); (window as any).lcdcTrack?.('dish_photo', { dish: b.getAttribute('aria-label')?.replace(' (voir la photo)', '') }); }
  }));
  document.addEventListener('click', () => btns.forEach((o) => o.classList.remove('open')));
</script>

<style>
  .taste { margin: 0; }
  .map { position: relative; width: 100%; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .grid { fill: none; stroke: var(--linen-line); stroke-width: 1; opacity: 0.7; }
  .land { fill: var(--kelsch-mist); stroke: var(--kelsch); stroke-opacity: 0.35; stroke-width: 1; }
  .thread { fill: none; stroke: var(--kelsch); stroke-width: 2.2; stroke-dasharray: 7 6; stroke-linecap: round; opacity: 0.85; }
  .leader { display: none; stroke: var(--ink-soft); stroke-width: 1.4; opacity: 0.6; }
  .pin {
    position: absolute; translate: -50% -50%;
    width: 1.75rem; height: 1.75rem; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--kelsch); color: #fff;
    font-family: var(--display); font-weight: 800; font-size: 0.9rem; line-height: 1;
    box-shadow: 0 0 0 3px var(--linen-shade), 0 4px 10px -4px rgb(10 20 50 / 0.6);
  }
  .pin.home, .dishes li:first-child .no { background: var(--linen); color: var(--kelsch); box-shadow: inset 0 0 0 3px var(--kelsch), 0 0 0 3px var(--linen-shade); }

  /* Phone & tablet: a numbered list under the map */
  .dishes { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 0.8rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .dishes li { display: flex; align-items: flex-start; gap: 0.7rem; min-width: 0; }
  .no { flex: none; margin-top: 0.35rem; width: 1.75rem; height: 1.75rem; border-radius: 50%; display: grid; place-items: center; background: var(--kelsch); color: #fff; font-family: var(--display); font-weight: 800; font-size: 0.9rem; }
  .dishes .tape { transform: rotate(var(--r)); white-space: normal; display: grid; gap: 0.1rem; }
  .dishes .tape b { font-weight: 750; letter-spacing: 0.02em; }
  .list { display: flex; flex-wrap: wrap; column-gap: 0.15rem; }
  .dish:not(:last-child)::after { content: ','; }
  .dish { font: inherit; color: inherit; background: none; border: 0; padding: 0; text-align: left; position: relative; }
  .has-img { cursor: pointer; text-decoration: underline dotted; text-underline-offset: 0.2em; text-decoration-thickness: 1.5px; }
  .has-img:focus-visible { outline: 2.5px solid var(--kelsch); outline-offset: 2px; }
  .peek {
    position: absolute; z-index: 30; left: 50%; bottom: calc(100% + 0.6rem);
    width: 11rem; translate: -50% 0; pointer-events: none;
    opacity: 0; transform: translateY(-8px); transition: opacity 0.18s ease-out, transform 0.28s var(--ease-out, ease-out);
  }
  .peek :global(img) { width: 100%; height: auto; filter: drop-shadow(0 14px 14px rgb(6 14 40 / 0.4)) drop-shadow(0 3px 4px rgb(6 14 40 / 0.3)); }
  .ill { display: table; margin: 0.3rem auto 0; padding: 0.1rem 0.5rem; border-radius: 999px; background: var(--linen); font-family: var(--body); font-size: 0.72rem; font-weight: 600; color: var(--ink-soft); box-shadow: 0 1px 3px rgb(10 20 50 / 0.2); }
  .ill.real { background: var(--kelsch); color: #fff; }
  .has-img:hover .peek, .has-img:focus-visible .peek, .has-img.open .peek { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .peek { transition: opacity 0.1s linear; transform: none; } }
  @media (max-width: 40rem) {
    .pin { width: 1.3rem; height: 1.3rem; font-size: 0.72rem; box-shadow: 0 0 0 2px var(--linen-shade); }
    .pin.home { box-shadow: inset 0 0 0 2px var(--kelsch), 0 0 0 2px var(--linen-shade); }
    .peek { left: 0; translate: 0 0; width: 9rem; }
  }

  /* Desktop: the list becomes tape labels stuck on the map */
  @media (min-width: 75rem) {
    .taste { position: relative; }
    .leader { display: inline; }
    .dishes { position: absolute; inset: 0; margin: 0; display: block; pointer-events: none; }
    .dishes li { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; pointer-events: auto; }
    .dishes .no { display: none; }
    .dishes li { width: max-content; max-width: 14.5rem; }
    .dishes li:hover, .dishes li:focus-within { z-index: 5; }
    .dishes .tape { font-size: 0.9rem; }
  }
</style>
