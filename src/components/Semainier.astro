---
// The semainier: how many at lunch and dinner, which meals of the week, and the session that fits.
import { pricing, euro, business } from '../config';
import { days, meals, defaultWeek, plan, copy, MAX_PEOPLE, type Preset } from '../lib/semainier';
import { url } from '../lib/links';
import Icon from './Icon.astro';

interface Props { location?: string; preset?: Preset }
const { location = 'hero', preset = 'famille' } = Astro.props;
const uid = `sem-${location}`;

const w = defaultWeek(preset);
const p = plan(w);
const c = copy(w);
const short = (d: string) => d.slice(0, 3);
const steps = [
  { m: 1, label: 'Au dîner', of: 'au dîner' },
  { m: 0, label: 'Au déjeuner', of: 'au déjeuner' },
] as const;
---
<div class="sem" data-semainier data-location={location} data-preset={preset}>
  <div class="sem-controls">
    <p class="sem-q">Vous êtes combien à table&nbsp;?</p>
    {steps.map((s) => (
      <div class="step" data-step={s.m}>
        <span class="step-l" id={`${uid}-l${s.m}`}>{s.label}</span>
        <div class="step-c">
          <button type="button" data-delta="-1" aria-label={`Une personne de moins ${s.of}`} disabled={w.people[s.m] === 0}>−</button>
          <output aria-labelledby={`${uid}-l${s.m}`} aria-live="polite" data-n>{w.people[s.m]}</output>
          <button type="button" data-delta="1" aria-label={`Une personne de plus ${s.of}`} disabled={w.people[s.m] === MAX_PEOPLE}>+</button>
        </div>
      </div>
    ))}
    <label class="sem-toggle">
      <input type="checkbox" name={`${uid}-c`} data-courses />
      <span class="box" aria-hidden="true"><Icon name="check" /></span>
      <span>Clément fait aussi les courses <span class="num">(+{euro(pricing.shopping)})</span></span>
    </label>
  </div>

  <fieldset class="sem-week-wrap">
    <legend class="sem-q">Cochez les repas de la semaine</legend>
    <div class="grid">
      {days.map((d, i) => <span class="dh" style={`--c:${i + 2};--r:1;--mc:1;--mr:${i + 2}`} aria-hidden="true">{short(d)}</span>)}
      {meals.map((m, k) => <span class:list={['mh', { off: w.people[k] === 0 }]} style={`--c:1;--r:${k + 2};--mc:${k + 2};--mr:1`} aria-hidden="true">{k ? 'Soir' : 'Midi'}</span>)}
      {meals.map((m, k) => days.map((d, i) => (
        <label class:list={['cell', { off: w.people[k] === 0 }]} style={`--c:${i + 2};--r:${k + 2};--mc:${k + 2};--mr:${i + 2}`}>
          <input type="checkbox" data-m={k} data-d={i} checked={w.on[k][i]} aria-label={`${d}, ${m.toLowerCase()}`} />
          <span class="face"><span class="dish">{p.dish[k][i] ?? ''}</span></span>
        </label>
      )))}
    </div>
    <p class="sem-summary" aria-live="polite" data-summary set:html={c.summary} />
  </fieldset>

  <div class="sem-foot">
    <p class="sem-price" aria-live="polite">
      <span class="big num" data-after>{c.after}</span>
      <span class="after" data-after-label hidden={!c.afterLabel}>après crédit d'impôt{business.sapNumber ? '' : '*'}</span>
      <span class="before num" data-before>{c.before}</span>
    </p>
    {!business.sapNumber && <p class="sem-note">* sous réserve de la déclaration Services à la personne, en cours.</p>}
    <a class="btn" href={url('/#devis')} data-sem-cta data-track="cta_click" data-track-location={`semainier-${location}`}>
      Recevoir mon menu et mon devis <Icon name="arrow" />
    </a>
  </div>
</div>

<style>
  .sem {
    position: relative;
    background: var(--linen);
    color: var(--ink);
    border-radius: 0.4rem;
    padding: clamp(1.1rem, 0.8rem + 1.5vw, 1.75rem);
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: 1fr;
    box-shadow: 0 30px 60px -30px rgb(4 10 32 / 0.7), 0 2px 0 rgb(255 255 255 / 0.6) inset;
  }
  /* thread stitched along the hem */
  .sem::before {
    content: '';
    position: absolute; inset: 0.45rem 0.45rem auto 0.45rem; height: 0;
    border-top: 2px dashed rgb(34 64 143 / 0.45);
    pointer-events: none;
  }
  .sem-q { font-weight: 700; font-size: 1.02rem; margin: 0 0 0.1rem; padding: 0; }
  .sem-controls { display: grid; gap: 0.6rem 0.9rem; grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr)); align-items: center; }
  .sem-controls > .sem-q { grid-column: 1 / -1; }

  .step { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.45rem 0.5rem 0.45rem 0.9rem; border-radius: var(--radius); background: #fff; box-shadow: inset 0 0 0 1.5px var(--linen-line); }
  .step-l { font-family: var(--display); font-weight: 700; font-size: 1.08rem; }
  .step-c { display: flex; align-items: center; gap: 0.25rem; }
  .step output { min-width: 2.2ch; text-align: center; font-family: var(--display); font-weight: 800; font-size: 1.45rem; font-variant-numeric: tabular-nums; color: var(--kelsch); }
  .step button {
    width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--linen-shade); color: var(--kelsch);
    font-family: var(--display); font-weight: 800; font-size: 1.4rem; line-height: 1;
    cursor: pointer; transition: background-color 0.2s, color 0.2s;
  }
  .step button:hover:not(:disabled) { background: var(--kelsch); color: #fff; }
  .step button:disabled { opacity: 0.35; cursor: default; }

  .sem-toggle { display: flex; align-items: center; gap: 0.7rem; cursor: pointer; font-weight: 600; position: relative; }
  .sem-toggle input { position: absolute; opacity: 0; width: 1.6rem; height: 1.6rem; margin: 0; }
  .sem-toggle .box { flex: none; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 0.3rem; background: #fff; box-shadow: inset 0 0 0 1.5px var(--linen-line); color: transparent; transition: background-color 0.2s, color 0.2s; }
  .sem-toggle .box :global(svg) { width: 1.1rem; height: 1.1rem; }
  .sem-toggle input:checked + .box { background: var(--kelsch); color: #fff; box-shadow: none; }
  .sem-toggle input:focus-visible + .box { outline: 3px solid var(--madder); outline-offset: 2px; }

  /* Week grid: days across, lunch/dinner down. On phones it turns: days down, lunch/dinner across. */
  .sem-week-wrap { border: 0; margin: 0; padding: 0; min-width: 0; container-type: inline-size; }
  .sem-week-wrap legend { margin-bottom: 0.6rem; }
  .grid { display: grid; grid-template-columns: 2.9rem repeat(7, minmax(0, 1fr)); gap: 0.3rem; }
  .grid > * { grid-column: var(--c); grid-row: var(--r); }
  .dh, .mh { font-family: var(--display); font-weight: 750; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft); }
  .dh { text-align: center; padding-bottom: 0.1rem; }
  .mh { align-self: center; }
  .mh.off { opacity: 0.45; }
  .cell { position: relative; display: block; min-height: 4.4rem; cursor: pointer; }
  .cell input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .face {
    display: flex; height: 100%; padding: 0.4rem 0.35rem; border-radius: 0.3rem;
    background: repeating-linear-gradient(135deg, transparent 0 6px, rgb(34 64 143 / 0.06) 6px 7px), var(--linen-shade);
    box-shadow: inset 0 0 0 1.5px transparent;
    transition: background-color 0.3s var(--ease-out), box-shadow 0.2s;
  }
  .cell:hover .face { box-shadow: inset 0 0 0 1.5px var(--kelsch); }
  .cell input:focus-visible + .face { outline: 3px solid var(--madder); outline-offset: 2px; }
  .cell input:checked + .face { background: var(--tape); box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 6px 12px -8px rgb(0 0 0 / 0.4); }
  .cell.off input:checked + .face { background: var(--linen-shade); box-shadow: inset 0 0 0 1.5px var(--linen-line); }
  .dish { font-family: var(--hand); font-size: 0.84rem; line-height: 1.15; color: var(--marker); hyphens: manual; overflow-wrap: break-word; }
  .cell.drop .face { animation: drop 0.45s var(--ease-out) both; }
  @keyframes drop {
    from { transform: translateY(-8px) rotate(-1.5deg); box-shadow: 0 14px 18px -10px rgb(0 0 0 / 0.35); }
    to { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .cell.drop .face { animation: none; } }
  @container (max-width: 34rem) {
    .grid { grid-template-columns: 2.6rem 1fr 1fr; gap: 0.25rem; }
    .grid > * { grid-column: var(--mc); grid-row: var(--mr); }
    .dh { text-align: left; align-self: center; }
    .mh { text-align: center; }
    .cell { min-height: 2.75rem; }
    .face { align-items: center; padding: 0.3rem 0.55rem; }
  }
  .sem-summary { margin-top: 0.8rem; font-size: 0.98rem; color: var(--ink-soft); }
  .sem-summary :global(strong) { color: var(--ink); }

  .sem-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-top: 1.1rem; border-top: 1px solid var(--linen-line); }
  .sem-price { display: grid; grid-template-columns: auto 1fr; column-gap: 0.75rem; align-items: baseline; }
  .sem-price .big { font-family: var(--display); font-weight: 800; font-size: clamp(2.3rem, 1.8rem + 2vw, 3.1rem); line-height: 1; letter-spacing: -0.03em; color: var(--kelsch); }
  .sem-price .after { font-weight: 700; }
  .sem-price .before { grid-column: 1 / -1; font-size: 0.95rem; color: var(--ink-soft); margin-top: 0.35rem; }
  .sem-foot .btn { flex: 1 1 16rem; max-width: 24rem; }
  .sem-note { flex: 1 1 100%; order: 3; font-size: 0.85rem; color: var(--ink-soft); }
</style>

<script>
  import { defaultWeek, plan, copy, describe, MAX_PEOPLE, type Week, type Preset } from '../lib/semainier';

  document.querySelectorAll<HTMLElement>('[data-semainier]').forEach((root) => {
    const w: Week = defaultWeek(root.dataset.preset as Preset);
    const boxes = [...root.querySelectorAll<HTMLInputElement>('.cell input')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const courses = root.querySelector<HTMLInputElement>('[data-courses]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const after = root.querySelector<HTMLElement>('[data-after]')!;
    const afterLabel = root.querySelector<HTMLElement>('[data-after-label]')!;
    const before = root.querySelector<HTMLElement>('[data-before]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-sem-cta]')!;
    let interacted = false;

    const sync = () => {
      boxes.forEach((b) => (w.on[+b.dataset.m! as 0 | 1][+b.dataset.d!] = b.checked));
      w.courses = courses.checked;
    };

    const detail = () => {
      const p = plan(w);
      const f = !p.tier ? 'conseil' : p.tier.id === 'devis' ? 'conseil' : p.tier.id;
      return { f, c: w.courses, people: Math.max(...w.people), repas: describe(w) };
    };

    const render = () => {
      const p = plan(w);
      steps.forEach((s) => {
        const m = +s.dataset.step! as 0 | 1;
        s.querySelector('output')!.textContent = String(w.people[m]);
        (s.querySelector('[data-delta="-1"]') as HTMLButtonElement).disabled = w.people[m] === 0;
        (s.querySelector('[data-delta="1"]') as HTMLButtonElement).disabled = w.people[m] === MAX_PEOPLE;
      });
      root.querySelectorAll<HTMLElement>('.mh').forEach((h, k) => h.classList.toggle('off', w.people[k] === 0));
      boxes.forEach((b) => {
        const m = +b.dataset.m! as 0 | 1;
        b.closest('.cell')!.classList.toggle('off', w.people[m] === 0);
        b.nextElementSibling!.querySelector('.dish')!.textContent = p.dish[m][+b.dataset.d!] ?? '';
      });

      const c = copy(w);
      summary.innerHTML = c.summary;
      after.textContent = c.after;
      afterLabel.hidden = !c.afterLabel;
      before.textContent = c.before;
    };

    const changed = () => {
      render();
      if (!interacted) {
        interacted = true;
        window.lcdcTrack?.('semainier_interaction', { link_location: root.dataset.location });
      }
      document.dispatchEvent(new CustomEvent('lcdc:selection', { detail: detail() }));
    };

    steps.forEach((s) => s.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-delta]');
      if (!btn) return;
      const m = +s.dataset.step! as 0 | 1;
      const was = w.people[m];
      w.people[m] = Math.min(MAX_PEOPLE, Math.max(0, was + Number(btn.dataset.delta)));
      // First person at this meal and nothing ticked yet: tick Monday to Friday.
      if (was === 0 && w.people[m] > 0 && !w.on[m].some(Boolean)) {
        boxes.filter((b) => +b.dataset.m! === m && +b.dataset.d! < 5).forEach((b) => (b.checked = true));
        sync();
      }
      changed();
    }));

    root.addEventListener('change', (e) => {
      const b = e.target as HTMLInputElement;
      if (b.matches('.cell input')) {
        const m = +b.dataset.m! as 0 | 1;
        if (b.checked && w.people[m] === 0) w.people[m] = 1; // ticking a meal nobody eats: count one person
        const cell = b.closest('.cell')!;
        cell.classList.remove('drop');
        if (b.checked) { void (cell as HTMLElement).offsetWidth; cell.classList.add('drop'); }
      }
      sync();
      changed();
    });

    cta.addEventListener('click', () => document.dispatchEvent(new CustomEvent('lcdc:selection', { detail: detail() })));
    sync();
    render();
  });
</script>
