---
import { pricing, afterCredit, euro } from '../config';
import { url } from '../lib/links';
import Icon from './Icon.astro';

interface Props { household?: 'small' | 'family' | 'large'; formula?: 'decouverte' | 'semaine'; location?: string }
const { household = 'family', formula = 'semaine', location = 'hero' } = Astro.props;
const uid = `sem-${location}`;

const days = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
const menu = ['Chili con carne, riz', 'Poisson, purée de petits pois', 'Légumes rôtis, burrata', 'Poke bowl', 'Beignets, sauce aigre-douce'];
const sizes = { small: { label: '1 à 2', n: 2 }, family: { label: '3 à 4', n: 4 }, large: { label: '5 et plus', n: 6 } };

// Server-side first paint (same maths as the client script below).
function plan(h: keyof typeof sizes, f: 'decouverte' | 'semaine') {
  const F = pricing.formulas[f];
  const n = sizes[h].n;
  const meals = h === 'large' ? F.dishes : Math.floor(F.portions / n);
  return { F, meals, dinners: Math.min(7, meals), lunches: Math.max(0, meals - 7) };
}
const init = plan(household, formula);
const config = { pricing, menu, sizes };
---
<div class="sem" data-semainier data-location={location} data-config={JSON.stringify(config)}>
  <div class="sem-controls">
    <fieldset class="seg">
      <legend>Vous êtes combien à la maison&nbsp;?</legend>
      <div class="seg-row">
        {Object.entries(sizes).map(([k, s]) => (
          <label>
            <input type="radio" name={`${uid}-h`} value={k} checked={k === household} />
            <span>{s.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
    <fieldset class="seg">
      <legend>Quelle formule&nbsp;?</legend>
      <div class="seg-row">
        {Object.values(pricing.formulas).map((F) => (
          <label>
            <input type="radio" name={`${uid}-f`} value={F.id} checked={F.id === formula} />
            <span>{F.label} <small>{F.dishes} plats</small></span>
          </label>
        ))}
      </div>
    </fieldset>
    <label class="sem-toggle">
      <input type="checkbox" name={`${uid}-c`} />
      <span class="box" aria-hidden="true"><Icon name="check" /></span>
      <span>Clément fait aussi les courses <span class="num">(+{euro(pricing.shopping)})</span></span>
    </label>
  </div>

  <div class="sem-week-wrap">
    <ol class="sem-week" aria-label="Votre semaine">
      {days.map((d, i) => (
        <li class:list={{ full: i < init.dinners }} style={`--i:${i}`}>
          <span class="day">{d}</span>
          <span class="dish">{i < init.dinners ? menu[i % init.F.dishes] : ''}</span>
          <span class="extra">{i < init.lunches ? '+ un midi' : ''}</span>
        </li>
      ))}
    </ol>
    <p class="sem-summary" aria-live="polite" data-summary>
      ≈ {init.F.portions} portions : {init.dinners} dîners pour {sizes[household].label} personnes{init.lunches ? `, plus ${init.lunches} déjeuners` : ''}.
    </p>
  </div>

  <div class="sem-foot">
    <p class="sem-price" aria-live="polite">
      <span class="big num" data-after>{euro(afterCredit(init.F.price))}</span>
      <span class="after">après crédit d'impôt</span>
      <span class="before num" data-before>soit {euro(init.F.price)} avant crédit · environ {init.F.hours} h chez vous</span>
    </p>
    <a class="btn" href={url('/#devis')} data-sem-cta data-track="cta_click" data-track-location={`semainier-${location}`}>
      Recevoir mon menu et mon devis <Icon name="arrow" />
    </a>
  </div>
</div>

<style>
  .sem {
    position: relative;
    background: var(--linen);
    color: var(--ink);
    border-radius: 0.4rem;
    padding: clamp(1.1rem, 0.8rem + 1.5vw, 1.75rem);
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: 1fr;
    box-shadow: 0 30px 60px -30px rgb(4 10 32 / 0.7), 0 2px 0 rgb(255 255 255 / 0.6) inset;
  }
  /* madder thread stitched along the hem */
  .sem::before {
    content: '';
    position: absolute; inset: 0.45rem 0.45rem auto 0.45rem; height: 0;
    border-top: 2px dashed rgb(176 40 31 / 0.55);
    pointer-events: none;
  }
  @media (min-width: 62rem) {
    .sem { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.35fr); grid-template-rows: auto auto; align-items: start; column-gap: 2.25rem; }
    .sem-controls { grid-row: 1 / span 2; }
    .sem-foot { grid-column: 2; padding-top: 0.9rem; }
    .sem-week li { min-height: 6.2rem; }
  }
  .sem-controls { display: grid; gap: 1rem; }
  .seg { border: 0; margin: 0; padding: 0; min-width: 0; }
  .seg legend { font-weight: 700; font-size: 1.02rem; margin-bottom: 0.5rem; padding: 0; }
  .seg-row { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .seg label { position: relative; flex: 1 1 0; min-width: 0; }
  .seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg span {
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    min-height: 3.2rem; padding: 0.45rem 0.6rem; text-align: center;
    border-radius: var(--radius);
    background: #fff; box-shadow: inset 0 0 0 1.5px var(--linen-line);
    font-family: var(--display); font-weight: 700; font-size: 1.08rem; line-height: 1.1;
    transition: background-color 0.2s, box-shadow 0.2s, color 0.2s;
  }
  .seg small { font-family: var(--body); font-weight: 500; font-size: 0.85rem; opacity: 0.8; }
  .seg label:hover span { box-shadow: inset 0 0 0 1.5px var(--kelsch); }
  .seg input:checked + span { background: var(--kelsch); color: #fff; box-shadow: inset 0 0 0 1.5px var(--kelsch); }
  .seg input:focus-visible + span { outline: 3px solid var(--madder); outline-offset: 2px; }

  .sem-toggle { display: flex; align-items: center; gap: 0.7rem; cursor: pointer; font-weight: 600; position: relative; }
  .sem-toggle input { position: absolute; opacity: 0; width: 1.6rem; height: 1.6rem; margin: 0; }
  .sem-toggle .box { flex: none; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 0.3rem; background: #fff; box-shadow: inset 0 0 0 1.5px var(--linen-line); color: transparent; transition: background-color 0.2s, color 0.2s; }
  .sem-toggle .box :global(svg) { width: 1.1rem; height: 1.1rem; }
  .sem-toggle input:checked + .box { background: var(--kelsch); color: #fff; box-shadow: none; }
  .sem-toggle input:focus-visible + .box { outline: 3px solid var(--madder); outline-offset: 2px; }

  .sem-week { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.3rem; }
  .sem-week li {
    min-height: 7.2rem; padding: 0.5rem 0.4rem; border-radius: 0.3rem;
    background: repeating-linear-gradient(135deg, transparent 0 6px, rgb(34 64 143 / 0.06) 6px 7px), var(--linen-shade);
    display: flex; flex-direction: column; gap: 0.35rem;
    transition: background-color 0.35s var(--ease-out);
  }
  .sem-week .day { font-family: var(--display); font-weight: 750; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft); }
  .sem-week .dish { font-family: var(--hand); font-size: 0.88rem; line-height: 1.2; color: var(--marker); hyphens: auto; overflow-wrap: anywhere; }
  .sem-week .extra { margin-top: auto; font-size: 0.78rem; font-weight: 700; color: var(--madder); }
  .sem-week li.full { background: var(--tape); box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 6px 12px -8px rgb(0 0 0 / 0.4); }
  .sem-week li.full .day { color: var(--kelsch); }
  .sem-week li.drop { animation: drop 0.55s var(--ease-out) both; animation-delay: calc(var(--i) * 55ms); }
  @keyframes drop {
    from { transform: translateY(-10px) rotate(-1.5deg); box-shadow: 0 14px 18px -10px rgb(0 0 0 / 0.35); }
    to { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .sem-week li.drop { animation: none; } }
  @media (max-width: 34rem) {
    .sem-week { grid-template-columns: 1fr; gap: 0.25rem; }
    .sem-week li { min-height: 0; flex-direction: row; align-items: baseline; gap: 0.75rem; padding: 0.45rem 0.7rem; }
    .sem-week .day { width: 2.6rem; flex: none; }
    .sem-week .extra { margin: 0 0 0 auto; white-space: nowrap; }
  }
  .sem-summary { margin-top: 0.7rem; font-size: 0.98rem; color: var(--ink-soft); }

  .sem-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-top: 1.1rem; border-top: 1px solid var(--linen-line); }
  .sem-price { display: grid; grid-template-columns: auto 1fr; column-gap: 0.75rem; align-items: baseline; }
  .sem-price .big { font-family: var(--display); font-weight: 800; font-size: clamp(2.3rem, 1.8rem + 2vw, 3.1rem); line-height: 1; letter-spacing: -0.03em; color: var(--kelsch); }
  .sem-price .after { font-weight: 700; }
  .sem-price .before { grid-column: 1 / -1; font-size: 0.95rem; color: var(--ink-soft); margin-top: 0.35rem; }
  .sem-foot .btn { flex: 1 1 16rem; max-width: 24rem; }
</style>

<script>
  import { euro, afterCredit } from '../config';
  type Cfg = { pricing: any; menu: string[]; sizes: Record<string, { label: string; n: number }> };

  document.querySelectorAll<HTMLElement>('[data-semainier]').forEach((root) => {
    const cfg: Cfg = JSON.parse(root.dataset.config!);
    const cells = [...root.querySelectorAll<HTMLLIElement>('.sem-week li')];
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const after = root.querySelector<HTMLElement>('[data-after]')!;
    const before = root.querySelector<HTMLElement>('[data-before]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-sem-cta]')!;
    let interacted = false;

    const read = () => {
      const h = (root.querySelector('input[name$="-h"]:checked') as HTMLInputElement).value;
      const f = (root.querySelector('input[name$="-f"]:checked') as HTMLInputElement).value;
      const c = (root.querySelector('input[name$="-c"]') as HTMLInputElement).checked;
      return { h, f, c };
    };

    const render = (animate: boolean) => {
      const { h, f, c } = read();
      const F = cfg.pricing.formulas[f];
      const S = cfg.sizes[h];
      const large = h === 'large';
      const meals = large ? F.dishes : Math.floor(F.portions / S.n);
      const dinners = Math.min(7, meals);
      const lunches = Math.max(0, meals - 7);
      cells.forEach((li, i) => {
        const full = i < dinners;
        li.classList.toggle('full', full);
        li.querySelector('.dish')!.textContent = full ? cfg.menu[i % F.dishes] : '';
        li.querySelector('.extra')!.textContent = i < lunches ? '+ un midi' : '';
        if (animate && full) {
          li.classList.remove('drop');
          void li.offsetWidth;
          li.classList.add('drop');
        }
      });
      const price = F.price + (c ? cfg.pricing.shopping : 0);
      const hours = F.hours + (c ? 1 : 0);
      if (large) {
        summary.textContent = `${F.dishes} plats préparés en grande quantité : ${dinners} dîners pour 5 personnes ou plus. Séance un peu plus longue, sur devis.`;
        after.textContent = `dès ${euro(afterCredit(price))}`;
        before.textContent = `soit dès ${euro(price)} avant crédit · durée ajustée à votre foyer`;
      } else {
        summary.textContent = `≈ ${F.portions} portions : ${dinners} dîners pour ${S.label} personnes${lunches ? `, plus ${lunches} déjeuners` : ''}${dinners < 7 && !lunches ? `, du lundi au ${['', '', '', 'mercredi', 'jeudi', 'vendredi', 'samedi'][dinners] || 'samedi'}` : ''}.`;
        after.textContent = euro(afterCredit(price));
        before.textContent = `soit ${euro(price)} avant crédit · environ ${hours} h${c ? ' courses comprises' : ' chez vous'}`;
      }
      return { h, f, c };
    };

    root.addEventListener('change', () => {
      const state = render(true);
      if (!interacted) {
        interacted = true;
        window.lcdcTrack?.('semainier_interaction', { link_location: root.dataset.location });
      }
      document.dispatchEvent(new CustomEvent('lcdc:selection', { detail: state }));
    });
    cta.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('lcdc:selection', { detail: read() }));
    });
    render(false);
  });
</script>
