---
// Authored icon set: one stroke weight (1.8), round caps, 24px grid.
interface Props { name: 'whatsapp' | 'arrow' | 'phone' | 'check' | 'mail' | 'pin'; label?: string }
const { name, label } = Astro.props;
---
{name === 'whatsapp' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}>
    <path d="M3.6 20.4l1.2-4.1A8.4 8.4 0 1 1 8 19.3z" />
    <path d="M9.1 8.3c.2-.4.6-.4.8-.4h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.4.8 1.3 1.8 2.4 2.3.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.2.3.4 0 .4-.1 1-.6 1.4-.5.4-1.4.7-2.3.4-1.3-.4-2.7-1.2-3.8-2.4-1-1.1-1.6-2.3-1.8-3.2-.1-.8.2-1.5.5-2.1z" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'arrow' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
)}
{name === 'phone' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.8h3.2l1.6 4-2 1.3a10.6 10.6 0 0 0 5.1 5.1l1.3-2 4 1.6V17a2 2 0 0 1-2.2 2A15.4 15.4 0 0 1 3 6a2 2 0 0 1 2-2.2z" /></svg>
)}
{name === 'check' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l4.8 4.8L19.5 7" /></svg>
)}
{name === 'mail' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M3.5 6l8.5 7 8.5-7" /></svg>
)}
{name === 'pin' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z" /><circle cx="12" cy="10" r="2.3" /></svg>
)}
