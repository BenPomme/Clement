---
import Base from '../layouts/Base.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { zone } from '../config';
import { crumbsLd } from '../lib/content';
import { url } from '../lib/links';

const base = import.meta.env.BASE_URL;
const notes: Record<string, string> = {
  'Mulhouse et agglomération': "Le cœur de la zone : Clément y intervient tous les jours de la semaine, en matinée comme l'après-midi.",
  'Pays de Saint-Louis': 'Pour les familles de frontaliers qui rentrent tard de Bâle : les plats sont prêts quand vous passez la porte.',
  Sundgau: "Altkirch et ses environs, à une demi-heure de Mulhouse.",
  'Thur et Florival': 'De Cernay à Guebwiller, au pied des Vosges.',
};
---
<Base
  head="linen"
  title="Zone d'intervention : batch cooking à Mulhouse, Saint-Louis, Altkirch, Cernay · La Cuisine de Clément"
  description="Clément se déplace pour cuisiner chez vous à Mulhouse, Rixheim, Riedisheim, Illzach, Kingersheim, Wittenheim, Saint-Louis, Altkirch, Cernay, Thann, Guebwiller. Déplacement compris."
  jsonLd={[crumbsLd(Astro.site, [{ name: 'Accueil', path: base }, { name: "Zone d'intervention", path: Astro.url.pathname }])]}
>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Fil d'Ariane"><a href={url('/')}>Accueil</a> / Zone d'intervention</nav>
      <div class="prose">
        <h1>Où Clément vient cuisiner</h1>
        <p class="lede">Le batch cooking à domicile, c'est dans votre cuisine. Clément se déplace dans tout le sud du Haut-Rhin, et le déplacement est compris dans le prix pour toutes les communes ci-dessous.</p>
      </div>
      <div class="areas">
        {zone.map((z) => (
          <section>
            <h2>{z.area}</h2>
            <p class="note-area">{notes[z.area]}</p>
            <ul>{z.towns.map((t) => <li>{t}</li>)}</ul>
          </section>
        ))}
      </div>
      <p class="prose">Votre commune n'est pas dans la liste&nbsp;? Colmar, Belfort, la vallée de Masevaux : demandez quand même, on trouve souvent une solution.</p>
    </div>
  </section>
  <QuoteSection segment="zone" />
</Base>
<style>
  .areas { display: grid; gap: 2.5rem 3.5rem; margin: 3rem 0; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  .areas h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .note-area { margin: 0.6rem 0 1rem; color: var(--ink-soft); }
  .areas ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .areas li { padding: 0.35rem 0.8rem; background: var(--linen-shade); border-radius: 999px; font-weight: 600; font-size: 0.98rem; }
</style>
