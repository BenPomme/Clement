---
// Source of public/og.jpg (1200×630). Screenshot it, don't index it.
import '../styles/global.css';
import Plate from '../components/Plate.astro';
import Mark from '../components/Mark.astro';
import chili from '../assets/dishes/chili-riz.png';
import burrata from '../assets/dishes/burrata-legumes.png';
import crumbles from '../assets/dishes/crumbles.png';
---
<html lang="fr"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og</title></head>
<body style="margin:0">
  <div class="og cloth">
    <div class="copy">
      <div class="brand"><Mark /><span>La Cuisine de Clément</span></div>
      <p class="h">Votre semaine, cuisinée chez vous.</p>
      <p class="s">Batch cooking à domicile<br />Mulhouse · Haut-Rhin</p>
    </div>
    <Plate src={chili} class="p1" alt="" sizes="520px" eager label="Lun · Chili con carne" labelPos="64% auto auto 0" />
    <Plate src={burrata} class="p2" alt="" sizes="360px" eager />
    <Plate src={crumbles} class="p3" alt="" sizes="260px" eager />
  </div>
</body></html>
<style>
  .og { width: 1200px; height: 630px; position: relative; overflow: hidden; }
  .copy { position: absolute; left: 64px; top: 60px; width: 560px; color: #fff; }
  .brand { display: flex; align-items: center; gap: 14px; font-family: var(--display); font-weight: 760; font-size: 30px; letter-spacing: -0.02em; }
  .brand :global(svg) { width: 54px; height: 54px; }
  .h { margin-top: 70px; font-family: var(--display); font-weight: 800; font-size: 84px; line-height: 0.95; letter-spacing: -0.035em; font-variation-settings: 'wdth' 82, 'opsz' 96; }
  .s { margin-top: 30px; font-size: 26px; color: #e6ebf8; }
  :global(.p1) { position: absolute !important; width: 520px; right: 30px; top: 20px; }
  :global(.p2) { position: absolute !important; width: 320px; right: 360px; bottom: -120px; }
  :global(.p3) { position: absolute !important; width: 230px; right: 40px; bottom: -20px; }
</style>
