---
import Base from '../layouts/Base.astro';
import Semainier from '../components/Semainier.astro';
import Plate from '../components/Plate.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { Picture } from 'astro:assets';
import { business, pricing, zone, euro, afterCredit, recurring } from '../config';
import { faq, faqLd, businessLd } from '../lib/content';
import { url, waLink } from '../lib/links';

import chili from '../assets/dishes/chili-riz.png';
import burrata from '../assets/dishes/burrata-legumes.png';
import crumbles from '../assets/dishes/crumbles.png';
import mille from '../assets/dishes/millefeuille-mangue.png';
import saumon from '../assets/dishes/saumon-oeuf-poche.png';
import poke from '../assets/dishes/poke-bowl.png';
import poisson from '../assets/dishes/poisson-petits-pois.png';
import entremets from '../assets/dishes/entremets-fruits-rouges.png';
import montblanc from '../assets/dishes/mont-blanc.png';
import beignets from '../assets/dishes/beignets.png';
import choco from '../assets/dishes/chocolat-griottes.png';
import plateau from '../assets/photos/plateau-crumbles.jpg';

const D = pricing.formulas.decouverte;
const S = pricing.formulas.semaine;
const wa = waLink('Bonjour Clément, je suis intéressé(e) par le batch cooking à domicile.');
const ld = [businessLd(Astro.site, import.meta.env.BASE_URL), faqLd()];
---
<Base
  title="Batch cooking à domicile à Mulhouse · La Cuisine de Clément"
  description={`Un chef cuisinier prépare chez vous les repas de la semaine : 3 à 5 plats maison, étiquetés, cuisine rangée. Mulhouse et Haut-Rhin. Dès ${euro(afterCredit(D.price))} après crédit d'impôt.`}
  jsonLd={ld}
>
  <!-- ── First viewport: the cloth ─────────────────────────── -->
  <section class="hero cloth" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">Votre semaine, cuisinée chez&nbsp;vous.</h1>
        <p class="hero-sub">
          Clément est chef cuisinier. Il vient chez vous, cuisine trois à cinq plats maison pour toute la semaine,
          les range au frigo, étiquetés, et repart en laissant la cuisine propre. À Mulhouse et dans le Haut-Rhin.
        </p>
      </div>
      <div class="hero-plates" aria-label="Quelques plats de Clément">
        <Plate src={chili} class="hp hp-1" alt="Riz basmati, chili con carne, crème, cheddar et oignons frits, quartier de citron vert" day="Lun" label="Chili con carne" sizes="(min-width: 62rem) 30vw, 70vw" labelPos="62% auto auto 2%" tilt={-3} eager />
        <Plate src={burrata} class="hp hp-2" alt="Burrata sur roquette, courgettes et aubergines rôties, poivrons confits, tomates séchées" day="Mer" label="Légumes rôtis, burrata" sizes="(min-width: 62rem) 22vw, 52vw" labelPos="auto -6% 4% auto" tilt={2} eager />
        <Plate src={crumbles} class="hp hp-3" alt="Quatre crumbles pomme-ananas en cassolettes, prêts à cuire" day="Ven" label="Crumbles × 4" sizes="(min-width: 62rem) 16vw, 38vw" labelPos="auto auto -4% 8%" tilt={-1} eager />
      </div>
      <div class="hero-sem">
        <Semainier location="hero" />
      </div>
    </div>
  </section>

  <!-- ── How it goes ─────────────────────────────────────── -->
  <section class="section on-linen" id="comment" aria-labelledby="comment-title">
    <div class="wrap">
      <h2 id="comment-title">Comment ça se passe</h2>
      <p class="lede measure">Une séance, c'est une matinée ou un après-midi. Vous n'avez rien à préparer, à part un peu de place dans le frigo.</p>
      <ol class="timeline">
        <li>
          <span class="when">La semaine d'avant</span>
          <h3>On s'appelle quinze minutes</h3>
          <p>Combien vous êtes, ce que vous aimez, ce que les enfants refusent, les allergies, et ce qu'il y a dans votre cuisine.</p>
        </li>
        <li>
          <span class="when">Trois jours avant</span>
          <h3>Vous recevez votre menu</h3>
          <p>Trois ou cinq plats de saison, que vous modifiez à volonté. Avec la liste de courses, ou Clément s'en occupe.</p>
        </li>
        <li>
          <span class="when">Le jour J</span>
          <h3>Clément cuisine chez vous</h3>
          <p>Trois à quatre heures, que vous soyez là ou non. Il range, fait la vaisselle et nettoie le plan de travail.</p>
        </li>
        <li>
          <span class="when">Du lundi au vendredi</span>
          <h3>Vous réchauffez, c'est tout</h3>
          <p>Chaque boîte porte le nom du plat, la date et la façon de le réchauffer. Le soir, il ne reste qu'à mettre la table.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ── The food ─────────────────────────────────────────── -->
  <section class="section cloth food" aria-labelledby="food-title">
    <div class="wrap">
      <div class="food-head">
        <h2 id="food-title">Ce que Clément cuisine</h2>
        <p class="measure">Des plats de cuisinier, pas de la cantine en barquette. Ces photos ont été prises par Clément, dans ses cuisines. Chez vous, le menu suit vos goûts et la saison.</p>
      </div>
      <div class="table">
        <Plate src={saumon} class="t t-a" alt="Muffins grillés, avocat, saumon fumé, œuf poché, oignon rouge, câpres et graines" label="Saumon fumé, œuf poché" sizes="(min-width: 62rem) 26vw, 46vw" labelPos="auto auto 2% 4%" tilt={-2} />
        <Plate src={poke} class="t t-b" alt="Poke bowl : riz, avocat, edamame, haricots verts, concombre, chou, sauce sésame" label="Poke bowl" sizes="(min-width: 62rem) 30vw, 52vw" labelPos="auto 6% -2% auto" tilt={2} />
        <Plate src={poisson} class="t t-c" alt="Filet de poisson blanc sous des rondelles de radis, purée de petits pois, beurre blanc" label="Poisson, petits pois, radis" sizes="(min-width: 62rem) 26vw, 50vw" labelPos="auto auto -6% 10%" tilt={-1} />
        <Plate src={mille} class="t t-d" alt="Mille-feuille de feuilles de brick caramélisées, crème légère et dés de mangue" label="Mille-feuille mangue" sizes="(min-width: 62rem) 24vw, 46vw" labelPos="4% auto auto -2%" tilt={3} />
        <Plate src={entremets} class="t t-e" alt="Entremets aux fruits rouges nappé de coulis, framboises et groseilles" label="Entremets fruits rouges" sizes="(min-width: 62rem) 22vw, 44vw" labelPos="auto -4% 6% auto" tilt={-2} />
        <Plate src={beignets} class="t t-f" alt="Beignets dorés aux herbes, citron vert, sauce aigre-douce pimentée" label="Beignets, sauce aigre-douce" sizes="(min-width: 62rem) 20vw, 42vw" labelPos="auto auto -6% 0" tilt={1} />
        <Plate src={montblanc} class="t t-g" alt="Mont-blanc : vermicelles de crème de marrons et chantilly dans un pot en porcelaine" label="Mont-blanc" sizes="(min-width: 62rem) 18vw, 40vw" labelPos="auto 0 -4% auto" tilt={-3} />
        <Plate src={choco} class="t t-h" alt="Dessert chocolat, griottes, chantilly et menthe fraîche" label="Chocolat, griottes" sizes="(min-width: 62rem) 14vw, 34vw" widths={[240, 360, 508]} labelPos="auto auto -10% -8%" tilt={2} />
      </div>
      <div class="choose">
        <h3>Vous choisissez, ou vous laissez faire</h3>
        <dl>
          <div><dt>Carte blanche</dt><dd>Clément compose un menu équilibré avec les produits du moment. Vous validez.</dd></div>
          <div><dt>Vos classiques</dt><dd>Le hachis de mamie, le curry du jeudi : donnez-lui vos recettes, il les cuisine.</dd></div>
          <div><dt>Un régime à suivre</dt><dd>Sans gluten, végétarien, peu salé, riche en protéines : le menu se construit autour.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ── Prices ───────────────────────────────────────────── -->
  <section class="section on-linen" id="tarifs" aria-labelledby="tarifs-title">
    <div class="wrap">
      <h2 id="tarifs-title">Deux formules, des prix clairs</h2>
      <p class="lede measure">Le prix comprend le temps de Clément, le menu sur mesure, le déplacement dans la zone et le ménage. Les ingrédients sont en plus, au prix du ticket.</p>

      <div class="prices">
        <table class="price-table">
          <caption class="visually-hidden">Formules de batch cooking à domicile</caption>
          <thead>
            <tr><th scope="col">Formule</th><th scope="col">Ce que vous avez</th><th scope="col" class="r">Prix</th><th scope="col" class="r">Après crédit d'impôt</th></tr>
          </thead>
          <tbody>
            {[D, S].map((F) => (
              <tr>
                <th scope="row"><span class="fname">{F.label}</span></th>
                <td>{F.dishes} plats, environ {F.portions} portions<br /><span class="muted">environ {F.hours} h chez vous</span></td>
                <td class="r num">{euro(F.price)}</td>
                <td class="r num strong">{euro(afterCredit(F.price))}</td>
              </tr>
            ))}
            <tr class="option">
              <th scope="row"><span class="fname">Courses</span></th>
              <td>Clément fait les courses avant la séance<br /><span class="muted">ingrédients refacturés au prix du ticket</span></td>
              <td class="r num">+{euro(pricing.shopping)}</td>
              <td class="r num strong">+{euro(afterCredit(pricing.shopping))}</td>
            </tr>
          </tbody>
        </table>

        <aside class="regular" aria-labelledby="regular-title">
          <h3 id="regular-title">Chaque semaine ou tous les quinze jours</h3>
          <p>Les séances régulières sont à <strong>−{pricing.recurringDiscount * 100} %</strong>.</p>
          <ul class="num">
            <li><span>Semaine</span><span>{euro(recurring(S.price))} <em>soit {euro(afterCredit(recurring(S.price)))}</em></span></li>
            <li><span>Découverte</span><span>{euro(recurring(D.price))} <em>soit {euro(afterCredit(recurring(D.price)))}</em></span></li>
          </ul>
          <p class="muted">Sans engagement : vous arrêtez quand vous voulez.</p>
        </aside>
      </div>

      <div class="credit">
        <p class="credit-big"><span class="num">50&nbsp;%</span> de crédit d'impôt</p>
        <div>
          <p>La préparation de repas à domicile, courses comprises, fait partie des services à la personne. La moitié de ce que vous payez à Clément vous revient, même si vous n'êtes pas imposable. Les ingrédients ne sont pas concernés.</p>
          <p class="muted">{business.sapNumber ? `Déclaration Services à la personne n° ${business.sapNumber}.` : 'Déclaration Services à la personne de La Cuisine de Clément en cours.'} <a href={url('/credit-impot-batch-cooking/')}>Comment ça marche, en détail</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── For whom ─────────────────────────────────────────── -->
  <section class="section on-linen who" aria-labelledby="who-title">
    <div class="wrap">
      <h2 id="who-title">Pour qui&nbsp;?</h2>
      <ul class="carte">
        <li><h3>Les familles qui courent</h3><p>Deux boulots, des enfants, les activités du mercredi. Le soir, le dîner est déjà là.</p></li>
        <li><h3><a href={url('/batch-cooking-jeunes-parents/')}>Les jeunes parents</a></h3><p>Les premières semaines avec un bébé, on mange mal et vite. Un cadeau de naissance qui sert vraiment.</p></li>
        <li><h3><a href={url('/preparation-repas-seniors/')}>Les seniors et leurs proches</a></h3><p>Des repas faits maison, adaptés, dans sa propre cuisine. Les enfants savent que papa ou maman mange bien.</p></li>
        <li><h3>Les régimes particuliers</h3><p>Sans gluten, végétarien, peu salé, diabète : pas de plat à part, un menu entier pensé pour vous.</p></li>
        <li><h3>Les sportifs</h3><p>Des plats riches en protéines, des portions calibrées, et plus besoin de cuisiner le dimanche soir.</p></li>
        <li><h3>Les frontaliers</h3><p>Vous travaillez à Bâle et rentrez tard ? Si vous habitez en France, vous avez droit au crédit d'impôt.</p></li>
      </ul>
    </div>
  </section>

  <!-- ── Clément ──────────────────────────────────────────── -->
  <section class="section chef" aria-labelledby="chef-title">
    <div class="wrap chef-grid">
      <figure class="chef-photo">
        <Picture src={plateau} alt="Plateau de cassolettes de crumble pomme-ananas en cuisine professionnelle" widths={[400, 700, 1000]} sizes="(min-width: 62rem) 40vw, 92vw" formats={['avif', 'webp']} layout="none" />
        <figcaption class="tape">Le même geste qu'en restaurant</figcaption>
      </figure>
      <div class="chef-copy">
        <h2 id="chef-title">Clément Bahr, cuisinier</h2>
        <p class="lede">Clément vient de la cuisine professionnelle. Ce qu'il fait chez vous, c'est ce qu'on apprend en brigade&nbsp;: des bases maison, des sauces qui ont du goût, des légumes bien traités, et l'organisation qui permet de sortir cinq plats en quatre heures.</p>
        <p>Avec La Cuisine de Clément, il cuisine pour des familles plutôt que pour des tables de restaurant&nbsp;: mêmes produits frais, même exigence. Il vit dans la région de Mulhouse.</p>
        <div class="chef-cta">
          <a class="btn" href="#devis" data-track="cta_click" data-track-location="chef">Parler à Clément de votre semaine <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Zone ─────────────────────────────────────────────── -->
  <section class="section zone-sec" aria-labelledby="zone-title">
    <div class="wrap">
      <h2 id="zone-title">Où Clément se déplace</h2>
      <p class="lede measure">Déplacement compris dans toutes ces communes. Un peu plus loin&nbsp;? Demandez.</p>
      <div class="zones">
        {zone.map((z) => (
          <div>
            <h3>{z.area}</h3>
            <p>{z.towns.join(' · ')}</p>
          </div>
        ))}
      </div>
      <p><a href={url('/zone-intervention/')}>Toute la zone d'intervention</a></p>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────── -->
  <section class="section on-linen" id="questions" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <h2 id="faq-title">Vos questions</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Quote ────────────────────────────────────────────── -->
  <section class="section cloth devis" id="devis" aria-labelledby="devis-title">
    <div class="wrap devis-grid">
      <div class="devis-copy">
        <h2 id="devis-title">Dites-nous qui mange à la maison</h2>
        <p>Clément vous rappelle sous 24&nbsp;heures avec une première idée de menu et le prix exact. Sans engagement.</p>
        {wa && (
          <a class="btn btn-wa" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="devis">
            <Icon name="whatsapp" /> Écrire sur WhatsApp
          </a>
        )}
        <Plate src={choco} class="devis-plate" alt="" sizes="12rem" widths={[240, 360]} />
      </div>
      <div class="sheet">
        <QuoteForm segment="accueil" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; padding: clamp(6rem, 4.5rem + 3vw, 7rem) 0 clamp(2.5rem, 2rem + 2vw, 3.5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  .hero h1 { font-size: clamp(3rem, 1.6rem + 5.4vw, 5.4rem); font-weight: 800; letter-spacing: -0.035em; line-height: 0.95; font-variation-settings: 'wdth' 82, 'opsz' 96; max-width: 11ch; }
  .hero-sub { margin-top: 1.5rem; font-size: clamp(1.1rem, 1rem + 0.45vw, 1.3rem); line-height: 1.55; max-width: 40ch; color: #eef1fa; }
  .hero-plates { position: relative; min-height: 22rem; }
  :global(.hp) { position: absolute; }
  :global(.hp-1) { width: min(78%, 30rem); right: 4%; top: 0; z-index: 1; }
  :global(.hp-2) { width: min(56%, 22rem); left: 0; top: 34%; z-index: 2; }
  :global(.hp-3) { width: min(40%, 15rem); right: 0; bottom: 0; z-index: 3; }
  .hero-sem { position: relative; z-index: 4; }
  @media (min-width: 62rem) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 3rem; row-gap: 2.5rem; }
    .hero-copy { align-self: center; padding-top: 1rem; }
    .hero-plates { min-height: 25rem; margin-right: calc(var(--gutter) * -0.5); }
    .hero-sem { grid-column: 1 / -1; margin-top: -2rem; }
  }
  @media (max-width: 40rem) {
    .hero-plates { min-height: 18rem; }
    :global(.hp-1) { width: 74%; }
    .hero-plates :global(.tape) { font-size: 0.85rem; }
    .hero-plates :global(.hp-1 .tape) { inset: 6% auto auto 0 !important; }
    .hero-plates :global(.hp-2 .tape) { inset: -6% auto auto 0 !important; }
    .hero-plates :global(.hp-3 .tape) { inset: auto 2% -6% auto !important; }
  }

  /* Timeline */
  .timeline { list-style: none; margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0; padding: 0; display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(14.5rem, 1fr)); position: relative; }
  .timeline li { position: relative; padding-top: 1.6rem; border-top: 3px solid var(--kelsch); }
  .timeline li::before { content: ''; position: absolute; top: -0.6rem; left: 0; width: 1rem; height: 1rem; border-radius: 50%; background: var(--linen); box-shadow: inset 0 0 0 3px var(--kelsch); }
  .timeline li:nth-child(3)::before { background: var(--madder); box-shadow: none; }
  .timeline .when { display: block; font-family: var(--hand); font-weight: 560; color: var(--kelsch); margin-bottom: 0.4rem; }
  .timeline h3 { margin-bottom: 0.6rem; }
  .timeline p { color: var(--ink-soft); }

  /* Food table */
  .food-head { display: grid; gap: 1.25rem; align-items: end; }
  .food-head p { color: #eef1fa; font-size: 1.12rem; }
  @media (min-width: 62rem) { .food-head { grid-template-columns: 1fr 1fr; } }
  .table { position: relative; margin-top: clamp(2.5rem, 2rem + 3vw, 5rem); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(0.5rem, 0.2rem + 1vw, 1.25rem); align-items: center; }
  :global(.t) { grid-column: span 6; }
  @media (min-width: 62rem) {
    :global(.t-a) { grid-column: 1 / span 4; }
    :global(.t-b) { grid-column: 5 / span 5; margin-top: -2rem; }
    :global(.t-c) { grid-column: 10 / span 3; align-self: end; }
    :global(.t-d) { grid-column: 1 / span 3; margin-top: 1rem; }
    :global(.t-e) { grid-column: 4 / span 4; }
    :global(.t-f) { grid-column: 8 / span 3; margin-top: 3rem; }
    :global(.t-g) { grid-column: 11 / span 2; }
    :global(.t-h) { grid-column: 9 / span 2; grid-row: 3; justify-self: center; width: 70%; margin-top: -1rem; }
  }
  .table :global(.tape) { font-size: 0.92rem; }
  .choose { margin-top: clamp(3rem, 2.5rem + 3vw, 5.5rem); padding-top: 2rem; border-top: 1px solid rgb(255 255 255 / 0.25); display: grid; gap: 1.5rem; }
  .choose dl { margin: 0; display: grid; gap: 1.5rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .choose dt { font-family: var(--display); font-weight: 750; font-size: 1.3rem; letter-spacing: -0.01em; margin-bottom: 0.35rem; }
  .choose dd { margin: 0; color: #e3e8f6; }
  @media (min-width: 62rem) { .choose { grid-template-columns: 0.8fr 2fr; } }

  /* Prices */
  .prices { margin-top: clamp(2rem, 1.5rem + 2vw, 3.5rem); display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 62rem) { .prices { grid-template-columns: 1.7fr 1fr; gap: 3rem; } }
  .price-table { width: 100%; border-collapse: collapse; }
  .price-table th, .price-table td { text-align: left; padding: 1.1rem 0.75rem 1.1rem 0; border-bottom: 1px solid var(--linen-line); vertical-align: top; }
  .price-table thead th { font-size: 0.9rem; font-weight: 700; color: var(--ink-soft); padding-bottom: 0.6rem; border-bottom: 2px solid var(--ink); }
  .price-table .r { text-align: right; padding-right: 0; padding-left: 0.75rem; white-space: nowrap; }
  .fname { font-family: var(--display); font-weight: 750; font-size: clamp(1.35rem, 1.1rem + 1vw, 1.8rem); letter-spacing: -0.02em; }
  .price-table td.num { font-size: 1.2rem; }
  .price-table .strong { font-family: var(--display); font-weight: 800; font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem); color: var(--kelsch); }
  .price-table .option .fname { font-size: 1.2rem; }
  .muted { color: var(--ink-soft); font-size: 0.95rem; }
  @media (max-width: 40rem) {
    .price-table thead { display: none; }
    .price-table tr { display: grid; grid-template-columns: 1fr auto; padding: 1rem 0; border-bottom: 1px solid var(--linen-line); }
    .price-table th, .price-table td { border: 0; padding: 0.15rem 0; }
    .price-table td:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .price-table td.num:not(.strong) { grid-row: 3; text-align: left; padding: 0.4rem 0 0; }
    .price-table td.strong { grid-row: 3; padding-top: 0.4rem; }
    .price-table td.strong::after { content: ' après crédit'; font-family: var(--body); font-size: 0.85rem; font-weight: 600; color: var(--ink-soft); }
  }
  .regular { background: var(--kelsch); color: #fff; border-radius: 0.4rem; padding: 1.6rem 1.5rem; display: grid; gap: 0.9rem; background-image: var(--weave-noise); }
  .regular h3 { font-size: 1.45rem; }
  .regular ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .regular li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px dashed rgb(255 255 255 / 0.35); font-weight: 700; }
  .regular em { font-style: normal; font-weight: 500; opacity: 0.85; margin-left: 0.4rem; }
  .regular .muted { color: var(--kelsch-mist); }
